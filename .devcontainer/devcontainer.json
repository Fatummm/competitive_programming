{
  "name": "Competitive Programming",

  "build": {
    "dockerfile": "Dockerfile"
  },

  "remoteUser": "sirnik",
  "runArgs": ["--rm"],

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-python.python"
      ],
      "settings": {
        "C_Cpp.default.compilerPath": "/usr/bin/g++",
        "C_Cpp.default.cppStandard": "c++20",
        "editor.formatOnSave": false,
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      }
    }
  }
}
